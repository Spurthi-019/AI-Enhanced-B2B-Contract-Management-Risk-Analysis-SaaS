# ContractIQ SaaS Environment Variables Template
# Copy this file to .env and configure your secure local secrets.

# Security & Authentication
JWT_SECRET=your_secure_base64_jwt_signing_key_here_must_be_at_least_256_bits

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/contractiq
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/contractiq

# AI & Ollama Configuration
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434

# MailDev SMTP Configuration
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
